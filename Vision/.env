# ============================================================================
# ARCHIVO: .env
# DESCRIPCIÓN: Parámetros de detección compartidos por vision_master.py,
#              todo.py y calibrar_vision.py (actualizar según calibrar_vision.py).
#              Una variable de entorno del sistema tiene prioridad sobre este archivo.
#              Formato: CLAVE=VALOR, comentarios solo en líneas propias.
# ============================================================================

# --- CÁMARA ---
# Exposición y balance de blancos fijos para que el HSV no cambie solo con la luz.
# Dependen de la cámara: ajustarlos con `v4l2-ctl --list-ctrls`
# Exposición en unidades de 100 µs (V4L2), temperatura de blancos en Kelvin
EXPOSICION=150
TEMPERATURA_BLANCOS=4500

# --- RANGOS DE COLOR HSV (H,S,V) ---
# Árbol (Verde)
VERDE_ARBOL_LOWER=35,40,40
VERDE_ARBOL_UPPER=85,255,255

# Piscinas y Contenedores Azules
AZUL_LOWER=100,80,50
AZUL_UPPER=130,255,255

# Pelotas Amarillas (Maduras)
AMARILLO_LOWER=22,80,100
AMARILLO_UPPER=35,255,255

# Pelotas Naranjas (Maduras)
NARANJA_LOWER=11,100,100
NARANJA_UPPER=21,255,255

# Pelotas Rojas / Contenedores Rojos (Rango dividido en HSV)
ROJO_LOWER1=0,100,100
ROJO_UPPER1=10,255,255
ROJO_LOWER2=160,100,100
ROJO_UPPER2=179,255,255

# Pelotas Sobremaduras (Negras)
NEGRO_LOWER=0,0,0
NEGRO_UPPER=180,255,45

# --- ÁRBOLES ---
ARBOL_AREA_MIN=15000

# --- PELOTAS ---
PELOTA_AREA_MIN=600
PELOTA_AREA_MAX=32000
PELOTA_CIRCULARIDAD_MIN=0.75
# Área / área del círculo envolvente: descarta cuadrados (0.64-0.77)
PELOTA_RELLENO_MIN=0.8

# --- PISCINAS (rectangulares) ---
PISCINA_AREA_MIN=4800
PISCINA_ASPECT_MIN=2.0
PISCINA_ASPECT_MAX=5.0

# --- CONTENEDORES (cuadrados) ---
CONTENEDOR_AREA_MIN=4000
CONTENEDOR_ASPECT_MIN=0.8
CONTENEDOR_ASPECT_MAX=1.25

# Solidez mínima de piscinas y contenedores (área / área del rectángulo)
SOLIDEZ_MIN=0.65
